{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "start",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 3000
    },
    {
      "name": "dev",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file=.env.local",
        "--import",
        "./scripts/dev-env.js",
        "--watch",
        "src/server/index.js"
      ],
      "port": 3002,
      "env": {
        "PORT": "3002",
        "BFL_HTTPS_PORT": "3445",
        "BFL_DB_PATH": "data/dev.db"
      }
    }
  ]
}
