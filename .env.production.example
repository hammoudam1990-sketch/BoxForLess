# ============================================================================
# Box for Less — Production Environment Configuration
# Copy this file to .env.production and provide real secrets.
# NEVER commit .env.production to version control!
# ============================================================================

NODE_ENV=production
DOMAIN=catalog.boxforless.com
PORT=3000
BFL_HOST=0.0.0.0

# ----------------------------------------------------------------------------
# 1. Staff Authentication (Administrator & Sales Roles)
# Choose strong passwords (at least 14 characters)
# ----------------------------------------------------------------------------
BFL_STAFF_USERNAME=admin
BFL_STAFF_PASSWORD=change-to-a-strong-admin-password-1234
BFL_SALES_USERNAME=sales-manager
BFL_SALES_PASSWORD=change-to-a-strong-sales-password-1234
BFL_REP_USERNAME=sales-rep
BFL_REP_PASSWORD=change-to-a-strong-rep-password-1234

# ----------------------------------------------------------------------------
# 2. Cryptographic Session Secrets
# Generate random 32-byte hex strings using:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# ----------------------------------------------------------------------------
BFL_SESSION_SECRET=paste-random-64-char-hex-string-here
BFL_CUSTOMER_SESSION_SECRET=paste-random-64-char-hex-string-here
BFL_CUSTOMER_HANDLE_SECRET=paste-random-64-char-hex-string-here

# ----------------------------------------------------------------------------
# 3. Odoo ERP Integration (Phase 1+)
# Obtain these from the Odoo Administrator
# ----------------------------------------------------------------------------
BFL_ODOO_URL=https://staging-or-live.odoo.com
BFL_ODOO_DB=bfl_production
BFL_ODOO_LOGIN=bfl-integration
BFL_ODOO_API_KEY=paste-odoo-api-key-here
BFL_ODOO_PROTOCOL=jsonrpc
BFL_ODOO_SYNC=on
BFL_ODOO_TIMEOUT_MS=10000
BFL_ODOO_MAX_PER_SECOND=4
BFL_ODOO_CASH_PARTNER_ID=

# ----------------------------------------------------------------------------
# 4. Reminders & Background Daemons
# BFL_REMINDERS=on (hourly automated payment reminders and snapshots)
# ----------------------------------------------------------------------------
BFL_REMINDERS=on
BFL_STOCK_FRESHNESS_HOURS=24
